{
  "name": "git-churn-chart",
  "version": "0.0.0",
  "private": true,
  "description": "Draw a chart of daily added and deleted lines of a local Git repository",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node src/main.ts --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
